# resume-warehouse 配置示例
#
# 复制为 .env 后填写自己的 key：
#   cp .env.example .env && chmod 600 .env
#
# 优先级：进程环境变量 > .env > 代码内默认值。
# 真实 key 只存在 .env（权限 600），永不提交、永不写日志、永不出现在 API 响应里。
# 本文件不得出现任何真实 key。

# ── LLM（唯一上云出口；OpenAI 兼容协议）────────────────────────────
# 取值：deepseek | openai_compatible | ollama | off（off = 完全禁用所有 LLM 调用）
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1

# 双模型路由：对话/改写/摘要用 chat 模型；JD 解析/公司偏好/匹配打分/组装策略用分析模型
LLM_MODEL=deepseek-chat
LLM_MODEL_ANALYSIS=deepseek-reasoner

# 在这里填你自己的 key（形如 sk-xxxxxxxx）；留空则 LLM 相关接口返回 503 LLM_NOT_CONFIGURED
LLM_API_KEY=

# 超时与重试（秒）。连接级与 HTTP 级重试共用同一个次数上限。
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# ── 应用 ────────────────────────────────────────────────────────────
# 默认端口；被占用时自动顺延到下一个空闲端口，实际端口写在 data/runtime/app_port
APP_PORT=8765

# 数据目录（必须落在项目 resume-warehouse/ 内；相对路径以项目根为基准）
DATA_DIR=./data
